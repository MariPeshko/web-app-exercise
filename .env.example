# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Parameters for FastAPI (we use service names from docker-compose)
# For Docker
DATABASE_URL=postgresql://quiz_admin:secure_pass@db:5432/quiz_game_db
# For local
# DATABASE_URL=postgresql://quiz_admin:secure_pass@localhost:5432/quiz_game_db
# jwt secret
SECRET_KEY=super_secret_random_string_at_least_32_bytes

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------
# AI Core (OpenAI integration)
# ---------------------------
# Required: API key used by `ai_core` to generate questions/chat/validation.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: custom user-agent for outbound AI requests.
# If omitted, AI core uses: RAG-Trivia-Game
USER_AGENT=RAG-Trivia-Game


# --------------------------------
# Analytics Core (service settings)
# --------------------------------
# Optional app metadata.
APP_NAME=analytics-core
APP_ENV=dev
APP_DEBUG=true
APP_VERSION=0.1.0

# Route prefix used by analytics endpoints.
API_PREFIX=/analytics

# Optional limits/timers used by realtime/export endpoints.
SSE_HEARTBEAT_SECONDS=15
EXPORT_MAX_POINTS=100000

# Optional API-key auth for analytics routes.
# Keep AUTH_ENABLED=false for local development.
AUTH_ENABLED=false
# Required only when AUTH_ENABLED=true.
ADMIN_API_KEY=replace-with-a-strong-random-token


# -----------------------------
# Analytics database connection
# -----------------------------
# Required for analytics core: PostgreSQL DSN (SQLAlchemy + psycopg).
# Format:
# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analytics_db
